# --- Alpaca (Paper is the safe default) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Use paper trading endpoint (default: true)
ALPACA_PAPER=true
# Live trading requires BOTH: ALPACA_LIVE=true AND ALPACA_PAPER=false
ALPACA_LIVE=false

# --- Kronos inference ---
KRONOS_MODEL_SIZE=base
MAX_CONTEXT=512
USE_GPU=false
INFERENCE_URL=http://localhost:8000
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000

# --- Trader ---
# Mix US equities/ETFs with Alpaca crypto pairs (slash form, 24/7): BTC/USD,ETH/USD,SOL/USD
TRADE_SYMBOLS=SPY,QQQ,IWM,SMH,XLF,NVDA,TSLA,AAPL,MSFT,AMZN,META,GOOGL,AMD,AVGO,NFLX,PLTR,COIN,MU,BTC/USD,ETH/USD,SOL/USD,JPM,BAC,ORCL
TRADE_INTERVAL_SECONDS=60
# Longer horizon fits Kronos better than scalp-style 5m×24
BAR_TIMEFRAME=1Hour
LOOKBACK_BARS=400
PRED_LEN=48
DRY_RUN=true
# Market data (Alpaca). Keep false for live bars.
MOCK_MARKET_DATA=false
# iex works on free/paper Alpaca; sip needs a paid market-data plan
ALPACA_DATA_FEED=iex
ALPACA_DATA_DELAY_MINUTES=20
# Set false if Alpaca HTTPS fails with CERTIFICATE_VERIFY_FAILED (corporate TLS)
SSL_VERIFY=true
# strict_forecast = path + bands + metrics + regime + top-K (mostly HOLD)
STRATEGY=strict_forecast
# Calibrated for Kronos on 1Hour bars, pred_len=48 (~2 trading days)
SIGNAL_THRESHOLD_PCT=0.6
SAMPLE_COUNT=4
MIN_CONFIDENCE=0.35
MAX_BAND_WIDTH_PCT=3.0
MAX_FORECAST_DRAWDOWN_PCT=1.0
MIN_HIT_RATE=0.48
MAX_MAPE=0.03
REQUIRE_METRICS_TRADEABLE=true
TAKE_PROFIT_FRACTION=0.6
TOP_K_ENTRIES=3
REGIME_MAX_VOL_PCT=5.0
REGIME_MIN_TREND_PCT=0.05
TRADER_API_HOST=0.0.0.0
TRADER_API_PORT=8001

# Risk limits (paper defaults sized for a ~25-symbol watchlist)
MAX_POSITION_SIZE=2000
MAX_PORTFOLIO_EXPOSURE=25000
STOP_LOSS_PCT=2.0

# --- Database / Redis ---
# Host apps: use 127.0.0.1 (avoid Windows localhost/IPv6 quirks).
# Port 5433 avoids clashing with a local Windows PostgreSQL on 5432.
DATABASE_URL=postgresql+asyncpg://kronos:kronos@127.0.0.1:5433/kronos
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_USER=kronos
POSTGRES_PASSWORD=kronos
POSTGRES_DB=kronos

# --- Dashboard ---
PORT=3033
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws
NEXT_PUBLIC_API_URL=http://localhost:8001
