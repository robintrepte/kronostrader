# --- Alpaca (Paper is the safe default) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Use paper trading endpoint (default: true)
ALPACA_PAPER=true
# Live trading requires BOTH: ALPACA_LIVE=true AND ALPACA_PAPER=false
ALPACA_LIVE=false

# --- Kronos inference ---
KRONOS_MODEL_SIZE=base
MAX_CONTEXT=512
USE_GPU=false
INFERENCE_URL=http://localhost:8000
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000

# --- Trader ---
TRADE_SYMBOLS=AAPL,MSFT,NVDA
TRADE_INTERVAL_SECONDS=60
BAR_TIMEFRAME=5Min
LOOKBACK_BARS=512
PRED_LEN=24
DRY_RUN=true
# Use synthetic OHLCV when true or when Alpaca keys are empty
MOCK_MARKET_DATA=false
STRATEGY=forecast_momentum
SIGNAL_THRESHOLD_PCT=0.5
TRADER_API_HOST=0.0.0.0
TRADER_API_PORT=8001

# Risk limits (required — no trades without these checks)
MAX_POSITION_SIZE=1000
MAX_PORTFOLIO_EXPOSURE=5000
STOP_LOSS_PCT=2.0

# --- Database / Redis ---
# Host apps: use localhost. Docker Compose trader service overrides host to "postgres"/"redis".
DATABASE_URL=postgresql+asyncpg://kronos:kronos@localhost:5432/kronos
REDIS_URL=redis://localhost:6379/0
POSTGRES_USER=kronos
POSTGRES_PASSWORD=kronos
POSTGRES_DB=kronos

# --- Dashboard ---
PORT=3033
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws
NEXT_PUBLIC_API_URL=http://localhost:8001
