FROM node:22-bookworm-slim AS base
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@11.18.0 --activate

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc turbo.json ./
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/ui/package.json packages/ui/
COPY apps/dashboard/package.json apps/dashboard/
RUN pnpm install --frozen-lockfile=false

FROM base AS builder
COPY --from=deps /repo /repo
COPY packages packages
COPY apps/dashboard apps/dashboard
COPY turbo.json tsconfig.base.json ./
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=http://localhost:8001
ARG NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
RUN pnpm --filter @kronos/shared-types build \
 && pnpm --filter @kronos/dashboard build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3033
ENV HOSTNAME=0.0.0.0
COPY --from=builder /repo/apps/dashboard/public ./apps/dashboard/public
COPY --from=builder /repo/apps/dashboard/.next/standalone ./
COPY --from=builder /repo/apps/dashboard/.next/static ./apps/dashboard/.next/static
EXPOSE 3033
CMD ["node", "apps/dashboard/server.js"]
